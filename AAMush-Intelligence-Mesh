<script>

/* NAVIGATION */

const buttons =
document.querySelectorAll(".nav");

const views =
document.querySelectorAll(".view");

buttons.forEach(btn => {

btn.addEventListener("click",()=>{

show(btn.dataset.view);

});

});


function show(id){

views.forEach(v=>{
v.classList.remove("active");
});

const target =
document.getElementById(id);

if(target){
target.classList.add("active");
}

buttons.forEach(b=>{
b.classList.toggle(
"active",
b.dataset.view===id
);
});

const active =
document.querySelector(
'.nav[data-view="'+id+'"]'
);

if(active){
document.getElementById("title")
.textContent =
active.innerText.trim();
}

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* EVENTS */

function eventLog(type,message){

const time =
new Date().toLocaleTimeString();

const html = `
<div class="event">
<span class="time">${time}</span>
<span class="type">${type}</span>
<span class="msg">${message}</span>
</div>
`;

document.getElementById(
"events"
).insertAdjacentHTML(
"afterbegin",html
);

document.getElementById(
"archive"
).insertAdjacentHTML(
"afterbegin",html
);

}

eventLog(
"SYSTEM",
"AAMush Intelligence Mesh initialized"
);

eventLog(
"NETWORK",
"Six corridor nodes available"
);

eventLog(
"MESH-01",
"Telemetry simulation initialized"
);

eventLog(
"FEEDER",
"AAMush-Tech Feeder ready"
);


/* NODE */

function node(city,country){

eventLog(
"CORRIDOR",
city+" node selected"
);

alert(
"AAMush Node Intelligence\n\n"+
"Node: "+city+"\n"+
"Country: "+country+"\n"+
"Status: ONLINE\n"+
"Mesh: STABLE\n"+
"Mode: SIMULATION"
);

}


/* ETA */

function eta(){

const from =
document.getElementById("from").value;

const to =
document.getElementById("to").value;

const condition =
document.getElementById("condition").value;

if(from===to){

document.getElementById(
"etaResult"
).innerHTML =
"<span class='danger'>Select different locations.</span>";

return;

}

let hours =
18+Math.floor(Math.random()*18);

if(condition==="Heavy Traffic") hours+=7;

if(condition==="Border Delay") hours+=10;

if(condition==="Priority Corridor") hours-=4;

const minutes =
Math.floor(Math.random()*60);

document.getElementById(
"etaResult"
).innerHTML = `

<strong style="color:var(--cyan)">
${from} → ${to}
</strong>

<br><br>

Estimated ETA:
<strong>
${hours}h ${minutes}m
</strong>

<br><br>

Condition:
${condition}

<br><br>

<small style="color:#607e91">
Demonstration calculation.
</small>
`;

eventLog(
"ETA",
"ETA calculated: "+from+" → "+to
);

}


/* CARGO */

function cargo(){

const id =
(document.getElementById(
"cargoInput"
).value || "AAM-2048")
.toUpperCase();

if(id==="AAM-2048"){

document.getElementById(
"cargoResult"
).innerHTML = `

<strong style="color:var(--cyan)">
Shipment AAM-2048
</strong>

<br><br>

Commodity: Copper concentrate
<br>
Tonnage: 428 tons
<br>
Origin: Dar es Salaam
<br>
Destination: Kigali
<br>
Status:
<span class="online">
● IN TRANSIT
</span>

`;

eventLog(
"CARGO",
"Shipment AAM-2048 located"
);

}else{

document.getElementById(
"cargoResult"
).innerHTML =
"<span class='danger'>No demonstration record found.</span>";

}

}


/* FEEDER */

function launchFeeder(){

show("feeder");

eventLog(
"FEEDER",
"AAMush-Tech Feeder launch initiated"
);

}


/* DIAGNOSTICS */

function diagnostics(){

eventLog(
"SYSTEM",
"Diagnostics completed. Simulated services responding."
);

alert(
"AAMush Diagnostics\n\n"+
"Command Centre: OK\n"+
"Corridor Map: OK\n"+
"Mesh-01: ONLINE\n"+
"Feeder: READY\n"+
"ETA Engine: READY\n"+
"Cargo Tracker: READY"
);

}


/* LIVE TELEMETRY */

let packets=1284721;

setInterval(()=>{

const vehicles =
244+Math.floor(Math.random()*12);

const tons =
12800+Math.floor(Math.random()*180);

const battery =
84+Math.floor(Math.random()*6);

document.getElementById(
"vehicles"
).textContent=vehicles;

document.getElementById(
"tons"
).textContent=
tons.toLocaleString();

document.getElementById(
"battery"
).textContent=
battery+"%";

document.getElementById(
"battery2"
).textContent=
battery+"%";

document.getElementById(
"battery3"
).textContent=
battery+"%";

document.getElementById(
"rate"
).textContent=
(2.1+Math.random()*.8)
.toFixed(1)+" Mbps";

packets+=
Math.floor(Math.random()*900);

document.getElementById(
"packets"
).textContent=
packets.toLocaleString();

},4000);

</script>

