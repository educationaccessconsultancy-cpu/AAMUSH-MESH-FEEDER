<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#020812">

<title>AAMush Intelligence Mesh</title>

<style>
:root{
--bg:#020812;
--panel:#071522;
--panel2:#091c2b;
--line:#12384f;
--cyan:#13c8ff;
--blue:#297cff;
--green:#16e39a;
--yellow:#ffd24d;
--red:#ff5274;
--purple:#9c6cff;
--text:#eaf8ff;
--muted:#7892a5;
}

*{box-sizing:border-box}

body{
margin:0;
background:
radial-gradient(circle at 70% 20%,rgba(0,150,210,.09),transparent 30%),
#020812;
color:var(--text);
font-family:Arial,Helvetica,sans-serif;
}

button,input,select{
font:inherit;
}

button{
cursor:pointer;
}

.app{
min-height:100vh;
display:flex;
}

/* SIDEBAR */

.sidebar{
position:fixed;
left:0;
top:0;
bottom:0;
width:250px;
padding:18px 13px;
background:linear-gradient(180deg,#061522,#020910);
border-right:1px solid var(--line);
z-index:50;
}

.logo{
padding:8px 10px 20px;
border-bottom:1px solid #0e293a;
margin-bottom:15px;
}

.logo h1{
font-size:22px;
margin:0;
}

.logo p{
font-size:8px;
letter-spacing:3px;
color:var(--cyan);
margin:5px 0 0;
}

.label{
font-size:9px;
letter-spacing:2px;
color:#4f7085;
margin:18px 9px 7px;
}

.nav{
width:100%;
padding:11px;
margin:2px 0;
border:1px solid transparent;
border-radius:8px;
background:transparent;
color:#8199aa;
text-align:left;
}

.nav:hover,
.nav.active{
background:#0a2232;
border-color:#164a64;
color:#fff;
box-shadow:inset 3px 0 var(--cyan);
}

.icon{
display:inline-block;
width:27px;
color:var(--cyan);
text-align:center;
}

.status{
margin-top:20px;
padding:11px;
border-radius:9px;
border:1px solid #14583f;
background:#031b14;
color:var(--green);
font-size:9px;
}

.status small{
display:block;
color:#5f8c7d;
margin-top:5px;
}

/* MAIN */

.main{
margin-left:250px;
width:calc(100% - 250px);
}

.topbar{
height:64px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 20px;
background:#030b13;
border-bottom:1px solid var(--line);
position:sticky;
top:0;
z-index:40;
}

.crumb{
font-size:11px;
color:#668296;
}

.crumb strong{
color:white;
}

.actions{
display:flex;
gap:8px;
}

.btn{
padding:9px 13px;
border-radius:7px;
border:1px solid #17455e;
background:#071925;
color:#ccefff;
}

.btn:hover{
border-color:var(--cyan);
}

.primary{
background:linear-gradient(135deg,#087fac,#075778);
border-color:#13bde9;
color:white;
}

.content{
padding:20px;
max-width:1600px;
margin:auto;
}

.view{
display:none;
}

.view.active{
display:block;
}

/* HERO */

.hero{
display:flex;
justify-content:space-between;
gap:20px;
margin-bottom:18px;
}

.eyebrow{
font-size:9px;
letter-spacing:2.5px;
color:var(--cyan);
}

.hero h2{
font-size:clamp(28px,4vw,45px);
margin:8px 0;
line-height:1.04;
}

.hero p{
max-width:780px;
color:var(--muted);
font-size:12px;
line-height:1.7;
}

.live{
height:max-content;
white-space:nowrap;
padding:9px 13px;
border-radius:20px;
border:1px solid #12654d;
background:#032219;
color:var(--green);
font-size:9px;
}

/* CARDS */

.card{
background:linear-gradient(145deg,#081a28,#040d16);
border:1px solid var(--line);
border-radius:13px;
box-shadow:0 0 30px rgba(0,180,255,.05);
}

.panel{
padding:16px;
}

.head{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
margin-bottom:13px;
}

.head h3{
margin:0;
font-size:14px;
}

.head span{
font-size:8px;
letter-spacing:1px;
color:#58798c;
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:11px;
}

.stat{
padding:14px;
}

.stat label{
font-size:8px;
letter-spacing:1px;
color:#638196;
}

.value{
display:block;
font-size:25px;
font-weight:bold;
margin:7px 0;
}

.good{
color:var(--green);
}

.warn{
color:var(--yellow);
}

.stat small{
font-size:9px;
color:#628397;
}

/* GRID */

.grid{
display:grid;
grid-template-columns:minmax(0,1.7fr) minmax(300px,.8fr);
gap:14px;
margin-top:14px;
}

.stack{
display:grid;
gap:14px;
}

/* MAP */

.map{
height:430px;
position:relative;
overflow:hidden;
border-radius:10px;
background:
radial-gradient(circle at 50% 50%,#084357,#061e2e 30%,#03131e 65%,#020a10);
}

.map:before{
content:"";
position:absolute;
inset:0;
background:
linear-gradient(rgba(20,130,170,.07) 1px,transparent 1px),
linear-gradient(90deg,rgba(20,130,170,.07) 1px,transparent 1px);
background-size:42px 42px;
}

.route{
position:absolute;
height:2px;
background:repeating-linear-gradient(
90deg,
var(--yellow) 0 9px,
transparent 9px 17px
);
opacity:.75;
animation:route 1.6s linear infinite;
}

@keyframes route{
to{background-position:34px 0}
}

.r1{width:170px;left:35%;top:41%;transform:rotate(-20deg)}
.r2{width:185px;left:44%;top:30%;transform:rotate(4deg)}
.r3{width:160px;left:64%;top:27%;transform:rotate(6deg)}
.r4{width:180px;left:45%;top:31%;transform:rotate(47deg)}
.r5{width:165px;left:34%;top:69%;transform:rotate(-15deg)}
.r6{width:175px;left:34%;top:42%;transform:rotate(30deg)}

.node{
position:absolute;
transform:translate(-50%,-50%);
text-align:center;
cursor:pointer;
z-index:5;
}

.dot{
width:17px;
height:17px;
margin:auto;
border-radius:50%;
background:var(--red);
border:3px solid #ffdbe2;
box-shadow:0 0 12px var(--red),0 0 30px rgba(255,82,116,.5);
animation:pulse 1.7s infinite;
}

@keyframes pulse{
50%{
box-shadow:
0 0 15px var(--red),
0 0 45px rgba(255,82,116,.8);
}
}

.node b{
display:block;
font-size:9px;
margin-top:3px;
text-shadow:0 2px 5px black;
white-space:nowrap;
}

.kampala{left:34%;top:40%}
.kigali{left:45%;top:29%}
.nairobi{left:64%;top:26%}
.mombasa{left:78%;top:32%}
.dar{left:69%;top:70%}
.bujumbura{left:32%;top:70%}

/* DEVICE */

.device{
height:175px;
display:grid;
place-items:center;
border:1px solid #15445d;
border-radius:10px;
background:radial-gradient(circle,#0a526a,#061620 65%);
}

.mesh{
width:150px;
height:74px;
display:grid;
place-items:center;
border:2px solid var(--cyan);
border-radius:14px;
color:#b6f3ff;
letter-spacing:2px;
font-weight:bold;
box-shadow:0 0 30px rgba(20,200,255,.4);
animation:meshglow 2s infinite;
}

@keyframes meshglow{
50%{box-shadow:0 0 50px rgba(20,200,255,.7)}
}

.telemetry{
display:grid;
grid-template-columns:1fr 1fr;
gap:8px;
margin-top:10px;
}

.telemetry div{
padding:9px;
border:1px solid #102e40;
border-radius:7px;
background:#06121c;
}

.telemetry small{
display:block;
font-size:8px;
color:#5c788b;
margin-bottom:4px;
}

/* EVENTS */

.events{
max-height:200px;
overflow:auto;
}

.event{
padding:8px 0;
border-bottom:1px solid #0e2939;
font-size:9px;
}

.time{
color:#4f7185;
}

.type{
color:var(--cyan);
margin-left:6px;
}

.msg{
color:#8ba5b5;
margin-left:6px;
}

/* MODULES */

.modules{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin-top:14px;
}

.module{
padding:15px;
cursor:pointer;
transition:.2s;
}

.module:hover{
transform:translateY(-2px);
border-color:#1b6688;
}

.module .big{
font-size:23px;
color:var(--cyan);
}

.module h3{
font-size:13px;
margin:9px 0 5px;
}

.module p{
font-size:10px;
color:#7892a4;
line-height:1.5;
}

/* TABLE */

.table{
width:100%;
border-collapse:collapse;
}

.table th,
.table td{
padding:10px;
border-bottom:1px solid #102c3e;
text-align:left;
font-size:10px;
}

.table th{
font-size:8px;
letter-spacing:1px;
color:#5b798c;
}

.online{
color:var(--green);
}

.warning{
color:var(--yellow);
}

.danger{
color:var(--red);
}

/* FORM */

.form{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
}

.field{
padding:10px;
background:#06121c;
border:1px solid var(--line);
border-radius:7px;
}

.field label{
display:block;
font-size:8px;
color:#5c7a8e;
margin-bottom:5px;
}

.field select,
.field input{
width:100%;
padding:8px;
background:#020a11;
color:white;
border:1px solid #17384c;
border-radius:5px;
}

/* PROFILE */

.profile{
display:grid;
grid-template-columns:155px 1fr;
gap:20px;
}

.profile img{
width:155px;
height:195px;
object-fit:cover;
border-radius:11px;
border:1px solid #1a5069;
}

/* MANUAL */

.manual{
line-height:1.7;
}

.manual h3{
color:var(--cyan);
font-size:14px;
margin-top:22px;
}

.manual p,
.manual li{
color:#8ca5b4;
font-size:11px;
}

/* MOBILE */

@media(max-width:1000px){

.sidebar{
width:70px;
padding:12px 7px;
}

.main{
margin-left:70px;
width:calc(100% - 70px);
}

.logo h1{
font-size:0;
text-align:center;
}

.logo h1:after{
content:"A";
font-size:25px;
color:var(--cyan);
}

.logo p,
.label,
.status,
.nav span:not(.icon){
display:none;
}

.nav{
text-align:center;
}

.stats{
grid-template-columns:repeat(2,1fr);
}

.grid{
grid-template-columns:1fr;
}

}

@media(max-width:650px){

.content{
padding:11px;
}

.hero{
display:block;
}

.live{
display:inline-block;
}

.stats{
grid-template-columns:1fr 1fr;
}

.modules{
grid-template-columns:1fr;
}

.form{
grid-template-columns:1fr;
}

.profile{
grid-template-columns:1fr;
}

.map{
height:340px;
}

.actions .btn:first-child{
display:none;
}

}
</style>
</head>

